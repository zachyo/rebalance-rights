# RPCs and deployment account. Never commit a real private key.
UNICHAIN_RPC_URL=https://sepolia.unichain.org
SOURCE_RPC_URL=https://sepolia.base.org
REACTIVE_RPC_URL=<reactive-lasna-rpc>
PRIVATE_KEY=<testnet-only-private-key>

# Official Reactive Callback Proxy and v4 PoolManager for the target testnet.
CALLBACK_PROXY=<official-unichain-callback-proxy>
POOL_MANAGER=<official-unichain-v4-pool-manager>
REFERENCE_OPERATOR=<base-sepolia-source-operator>
DEPLOYER=<destination-deployer-address>

# Demo roles. These accounts approve/deposit their own LP shares after setup.
ALICE=<alice-address>
BAO=<bao-address>
LATE_LP=<late-lp-address>
SEARCHER_A=<searcher-a-address>
SEARCHER_B=<searcher-b-address>

# Fill these with addresses emitted by the deployment scripts.
REFERENCE_MARKET=<source-market>
LIQUIDITY_TOKEN=<lp-share-token>
BID_TOKEN=<bid-token>
POOL_TOKEN_A=<pool-token-a>
POOL_TOKEN_B=<pool-token-b>
POOL_TOKEN_0=<sorted-pool-token-0>
POOL_TOKEN_1=<sorted-pool-token-1>
VAULT=<reward-vault>
CONTROLLER=<controller>
AUCTION=<auction>
HOOK=<mined-v4-hook>
ROUTER=<v4-router>
RSC=<reactive-contract>
RVM_ID=<reactive-rvm-identity>
PAIR_ID=<bytes32-pair-id>
POOL_ID=<bytes32-pool-id>
SOURCE_CHAIN_ID=84532
DESTINATION_CHAIN_ID=1301
AUCTION_DURATION=30
EXECUTION_DURATION=120
